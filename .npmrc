# engines.node in package.json is pinned to 22.x to match CI (.github/workflows/ci.yml)
# and Vercel. This makes npm refuse to install (rather than just warn) on any other major
# version — the actual cause of npm ci breaking twice: a local npm 11 install (bundled with
# a newer local Node) produced a lockfile CI's npm 10 (bundled with Node 22) rejected.
engine-strict=true
