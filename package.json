{
  "name": "blessyourloaf",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run build:offline-shell && serwist build serwist.config.mjs",
    "build:offline-shell": "esbuild src/offline-shell/main.ts --bundle --minify --format=esm --target=es2020 --outfile=public/offline-recipe.js",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify-schema": "node scripts/verify-schema.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.101.0",
    "@serwist/next": "^9.5.12",
    "@stripe/stripe-js": "^9.7.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.107.0",
    "dexie": "^4.4.4",
    "next": "16.2.7",
    "next-intl": "^4.13.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "serwist": "^9.5.12",
    "stripe": "^22.2.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@serwist/cli": "^9.5.12",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/stripe": "^8.0.416",
    "@types/web-push": "^3.6.4",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "fake-indexeddb": "^6.2.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^2.1.8"
  }
}
